<UserControl
    x:Class="GeekFlashToolX.Views.SettingsView"
    x:DataType="vm:SettingsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:core="using:GeekFlashToolX.Core.Models"
    xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
    xmlns:vm="using:GeekFlashToolX.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            Classes="page"
            MaxWidth="920"
            Spacing="{StaticResource Space6}">
            <StackPanel Spacing="{StaticResource Space2}">
                <TextBlock Classes="eyebrow mono" Text="{I18 Settings.Eyebrow}" />
                <TextBlock Classes="h1" Text="{I18 Settings.Title}" />
                <TextBlock
                    Classes="body"
                    HorizontalAlignment="Left"
                    MaxWidth="720"
                    Text="{I18 Settings.Subtitle}" />
            </StackPanel>

            <Border Classes="card">
                <StackPanel Spacing="{StaticResource Space4}">
                    <StackPanel Spacing="{StaticResource Space1}">
                        <TextBlock Classes="h2" Text="{I18 Settings.AppearanceTitle}" />
                        <TextBlock Classes="caption" Text="{I18 Settings.AppearanceBody}" />
                    </StackPanel>
                    <Border Classes="setting-row">
                        <Grid ColumnDefinitions="*,240" ColumnSpacing="24">
                            <TextBlock Text="{I18 Settings.Theme}" VerticalAlignment="Center" />
                            <ComboBox
                                AutomationProperties.Name="{I18 Settings.Theme}"
                                Classes="settings-select"
                                Grid.Column="1"
                                ItemsSource="{Binding ThemeOptions}"
                                SelectedItem="{Binding SelectedTheme}"
                                x:Name="ThemeComboBox">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ThemeOption">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="setting-row">
                        <Grid ColumnDefinitions="*,240" ColumnSpacing="24">
                            <TextBlock Text="{I18 Settings.Language}" VerticalAlignment="Center" />
                            <ComboBox
                                AutomationProperties.Name="{I18 Settings.Language}"
                                Classes="settings-select"
                                Grid.Column="1"
                                ItemsSource="{Binding Languages}"
                                SelectedItem="{Binding SelectedLanguage}"
                                x:Name="LanguageComboBox">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="core:LanguageOption">
                                        <TextBlock Text="{Binding NativeName}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="setting-row">
                        <Grid ColumnDefinitions="*,240" ColumnSpacing="24">
                            <TextBlock Text="{I18 Settings.Accent}" VerticalAlignment="Center" />
                            <ComboBox
                                AutomationProperties.Name="{I18 Settings.Accent}"
                                Classes="settings-select"
                                Grid.Column="1"
                                ItemsSource="{Binding AccentOptions}"
                                SelectedItem="{Binding SelectedAccent}"
                                x:Name="AccentComboBox">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AccentOption">
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="{StaticResource Space2}"
                                            VerticalAlignment="Center">
                                            <Ellipse
                                                Fill="{Binding Hex}"
                                                Height="12"
                                                Width="12" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Margin="0,0,24,0" Spacing="{StaticResource Space1}">
                        <TextBlock Classes="h2" Text="{I18 Settings.AnimationTitle}" />
                        <TextBlock
                            Classes="caption"
                            Text="{I18 Settings.AnimationBody}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        AutomationProperties.Name="{I18 Settings.AnimationTitle}"
                        Grid.Column="1"
                        IsChecked="{Binding AnimationsEnabled}"
                        OffContent=""
                        OnContent=""
                        VerticalAlignment="Center"
                        x:Name="AnimationSwitch" />
                </Grid>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="h2" Text="{I18 Settings.UpdateTitle}" />
                            <TextBlock
                                Classes="caption"
                                Text="{I18 Settings.UpdateBody}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            AutomationProperties.Name="{I18 Settings.UpdateTitle}"
                            Grid.Column="1"
                            IsChecked="{Binding AutoCheckUpdates}"
                            OffContent=""
                            OnContent=""
                            VerticalAlignment="Center"
                            x:Name="AutoUpdateSwitch" />
                    </Grid>
                    <Button
                        Classes="primary"
                        Command="{Binding CheckUpdatesCommand}"
                        Content="{I18 {Binding CheckUpdatesKey}}"
                        HorizontalAlignment="Left"
                        IsEnabled="{Binding !IsCheckingUpdates}"
                        x:Name="CheckUpdatesButton" />
                </StackPanel>
            </Border>

            <Border Classes="settings-file-panel">
                <StackPanel Spacing="{StaticResource Space2}">
                    <TextBlock Classes="caption" Text="{I18 Settings.Path}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox
                            AutomationProperties.Name="{I18 Settings.Path}"
                            Classes="settings-path"
                            IsReadOnly="True"
                            Text="{Binding SettingsPath}"
                            TextWrapping="NoWrap"
                            x:Name="SettingsPathBox" />
                        <Button
                            AutomationProperties.Name="{I18 Settings.CopyPath}"
                            Classes="icon-button"
                            Command="{Binding CopySettingsPathCommand}"
                            Grid.Column="1"
                            ToolTip.Tip="{I18 Settings.CopyPath}">
                            <iconPacks:PackIconCodicons
                                Height="18"
                                Kind="Copy"
                                Width="18" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
