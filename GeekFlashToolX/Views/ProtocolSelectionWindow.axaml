<Window
    x:Class="GeekFlashToolX.Views.ProtocolSelectionWindow"
    x:DataType="vm:ProtocolSelectionViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GeekFlashToolX.ViewModels"
    Width="400"
    Height="220"
    MinWidth="360"
    MinHeight="200"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Title="选择连接协议"
    Background="{DynamicResource SurfaceBackgroundBrush}">
    <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <TextBlock Classes="h2" Text="选择连接协议" />
        <TextBlock Grid.Row="1" Classes="caption" Text="请选择此设备使用的协议。" />
        <ComboBox Grid.Row="2" VerticalAlignment="Top" ItemsSource="{Binding Protocols}"
                  SelectedItem="{Binding SelectedProtocol}" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="取消" Command="{Binding CancelCommand}" />
            <Button Classes="primary" Content="继续" Command="{Binding ConfirmCommand}" />
        </StackPanel>
    </Grid>
</Window>
